:root {
    --surface: #ffffff;
    --surface-soft: #f5f7fb;
    --surface-line: #dce3ec;
    --text-main: #172033;
    --text-muted: #667085;
    --nav: #101828;
    --nav-soft: #1d2939;
    --primary: #355cff;
    --primary-dark: #2545d9;
    --success: #14a46f;
    --success-dark: #0d8056;
    --amber: #f6a609;
    --danger: #d14343;
    --radius: 8px;
    --shadow-soft: 0 16px 40px rgba(16, 24, 40, 0.08);
}

html {
    min-height: 100%;
}

body {
    min-height: 100vh;
    color: var(--text-main);
    background: var(--surface-soft);
    font-family: "Roboto", "Segoe UI", Arial, sans-serif;
    letter-spacing: 0;
}

a {
    text-decoration: none;
}

.app-body {
    padding-top: 72px;
}

.app-shell {
    width: min(100% - 32px, 1500px);
    margin: 0 auto;
    padding: 28px 0 48px;
}

.app-navbar {
    min-height: 72px;
    background: var(--nav);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 28px rgba(16, 24, 40, 0.18);
}

.app-navbar-inner {
    width: min(100% - 32px, 1500px);
    padding: 0;
}

.app-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #ffffff;
    font-weight: 700;
}

.app-brand:hover,
.app-brand:focus {
    color: #ffffff;
}

.brand-mark {
    display: inline-flex;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: #ffffff;
    color: var(--nav);
    font-size: 0.8rem;
    font-weight: 800;
}

.app-navbar .nav-link {
    color: rgba(255, 255, 255, 0.72);
    font-weight: 500;
}

.app-navbar .nav-link:hover,
.app-navbar .nav-link:focus {
    color: #ffffff;
}

.app-nav-links {
    gap: 4px;
    margin-left: 24px;
}

.app-nav-user {
    align-items: center;
    gap: 10px;
}

.user-pill {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-weight: 600;
}

.app-navbar-toggler {
    border-color: rgba(255, 255, 255, 0.28);
}

.app-navbar-toggler .navbar-toggler-icon {
    filter: invert(1);
}

.page-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 20px;
}

.eyebrow {
    display: block;
    margin-bottom: 6px;
    color: var(--success);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.page-title {
    margin: 0;
    color: var(--text-main);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: 0;
}

.page-subtitle {
    max-width: 720px;
    margin: 8px 0 0;
    color: var(--text-muted);
    font-size: 1rem;
}

.page-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
}

.app-btn {
    min-height: 42px;
    border-radius: 8px;
    font-weight: 700;
    box-shadow: none;
}

.app-btn-primary {
    border-color: var(--primary);
    background: var(--primary);
    color: #ffffff;
}

.app-btn-primary:hover,
.app-btn-primary:focus {
    border-color: var(--primary-dark);
    background: var(--primary-dark);
    color: #ffffff;
}

.app-btn-success {
    border-color: var(--success);
    background: var(--success);
    color: #ffffff;
}

.app-btn-success:hover,
.app-btn-success:focus {
    border-color: var(--success-dark);
    background: var(--success-dark);
    color: #ffffff;
}

.app-btn-danger {
    border-color: var(--danger);
    background: var(--danger);
    color: #ffffff;
}

.app-btn-danger:hover,
.app-btn-danger:focus {
    border-color: #b42323;
    background: #b42323;
    color: #ffffff;
}

.app-btn-ghost {
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: #ffffff;
}

.app-btn-ghost:hover,
.app-btn-ghost:focus {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

.app-btn-light {
    border: 1px solid var(--surface-line);
    background: #ffffff;
    color: var(--text-main);
}

.app-btn-light:hover,
.app-btn-light:focus {
    border-color: #bdc8d6;
    background: #f8fafc;
    color: var(--text-main);
}

.portal-panel {
    border: 1px solid var(--surface-line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
}

.metric-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 18px;
}

.metric-item {
    min-height: 88px;
    padding: 18px 20px;
    border: 1px solid var(--surface-line);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 10px 28px rgba(16, 24, 40, 0.05);
}

.metric-item span {
    display: block;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
}

.metric-item strong {
    display: block;
    margin-top: 8px;
    color: var(--text-main);
    font-size: 1.9rem;
    line-height: 1;
}

.grid-panel {
    overflow: hidden;
}

.grid-panel-head {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border-bottom: 1px solid var(--surface-line);
    background: var(--surface-line);
}

.grid-stat {
    min-height: 86px;
    padding: 18px 20px;
    background: #ffffff;
}

.grid-stat span {
    display: block;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 700;
}

.grid-stat strong {
    display: block;
    margin-top: 8px;
    color: var(--text-main);
    font-size: 1.45rem;
    line-height: 1;
}

.grid-host {
    padding: 16px;
}

.grid-action-token {
    display: none;
}

.dx-grid-host {
    padding: 16px;
}

#calculationGrid {
    min-height: 180px;
}

#calculationGrid .dx-datagrid-rowsview {
    min-height: 48px;
}

#calculationGrid .dx-data-row > td {
    height: 44px;
}

.grid-fallback-table {
    margin-top: 0;
}

.grid-fallback-table .app-table {
    margin-bottom: 0;
}

.dashboard-panel {
    margin-bottom: 18px;
    overflow: hidden;
}

.dashboard-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px;
    border-bottom: 1px solid var(--surface-line);
}

.dashboard-head strong {
    display: block;
    color: var(--text-main);
    font-size: 1rem;
}

.dashboard-head span {
    display: block;
    margin-top: 2px;
    color: var(--text-muted);
    font-size: 0.85rem;
}

#shapeChart {
    height: 260px;
    padding: 8px 12px 14px;
}

.dx-grid-actions {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
}

.dx-grid-actions .action-link,
.dx-grid-actions .inline-action-form {
    margin: 0;
}

.dx-grid-actions .inline-action-form {
    display: inline-flex;
}

.dx-datagrid .table-shape,
.dx-datagrid .status-badge,
.dx-datagrid .muted-badge {
    vertical-align: middle;
}

.grid-detail-panel {
    padding: 14px 16px;
    background: #fbfcff;
}

.grid-detail-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(160px, 1fr));
    gap: 10px;
}

.grid-detail-item {
    min-height: 66px;
    padding: 12px;
    border: 1px solid #dce3ec;
    border-radius: 8px;
    background: #ffffff;
}

.grid-detail-item span {
    display: block;
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
}

.grid-detail-item strong {
    display: block;
    margin-top: 6px;
    color: var(--text-main);
    font-size: 0.96rem;
    font-weight: 800;
    word-break: break-word;
}

.table-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px;
    border-bottom: 1px solid var(--surface-line);
}

.table-toolbar strong {
    display: block;
    color: var(--text-main);
    font-size: 1rem;
}

.table-toolbar span {
    display: block;
    margin-top: 2px;
    color: var(--text-muted);
    font-size: 0.85rem;
}

.table-search {
    width: min(320px, 100%);
}

.toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
}

.filter-group {
    display: inline-flex;
    min-height: 44px;
    overflow: hidden;
    border: 1px solid var(--surface-line);
    border-radius: 8px;
    background: #ffffff;
}

.filter-button {
    min-width: 92px;
    border: 0;
    border-right: 1px solid var(--surface-line);
    background: transparent;
    color: var(--text-muted);
    font-weight: 800;
}

.filter-button:last-child {
    border-right: 0;
}

.filter-button:hover,
.filter-button:focus,
.filter-button.is-active {
    background: #eef4ff;
    color: var(--primary-dark);
}

.shape-filter {
    width: 180px;
}

.app-table {
    --bs-table-bg: #ffffff;
    --bs-table-striped-bg: #fbfcff;
    color: var(--text-main);
}

.app-table thead th {
    padding: 14px 16px;
    border-bottom: 1px solid var(--surface-line);
    background: #f8fafc;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    white-space: nowrap;
}

.app-table tbody td {
    padding: 14px 16px;
    border-bottom: 1px solid #eef2f7;
    vertical-align: middle;
    white-space: nowrap;
}

.app-table tbody tr:hover td {
    background: #fbfcff;
}

.table-shape {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    background: #eef4ff;
    color: var(--primary-dark);
    font-size: 0.82rem;
    font-weight: 800;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 800;
}

.status-badge-done {
    background: #e9f8f2;
    color: var(--success-dark);
}

.status-badge-wait {
    background: #fff6df;
    color: #9a6700;
}

.empty-table-cell {
    height: 120px;
    color: var(--text-muted);
    text-align: center;
}

.muted-badge {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    background: #eef2f7;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
}

.status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--amber);
}

.action-link {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    border-radius: 7px;
    border: 1px solid var(--surface-line);
    background: #ffffff;
    color: var(--text-main);
    font-size: 0.82rem;
    font-weight: 700;
}

.action-link:hover,
.action-link:focus {
    border-color: #bdc8d6;
    background: #f8fafc;
    color: var(--text-main);
}

.action-link-danger {
    color: var(--danger);
}

.action-link-success {
    color: var(--success-dark);
}

.inline-action-form {
    display: inline-flex;
    margin: 0 4px 0 0;
    vertical-align: middle;
}

.inline-action-form .action-link {
    cursor: pointer;
}

.alert {
    border-radius: 8px;
    border-width: 1px;
}

.auth-body {
    background: #eef2f7;
}

.auth-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 28px;
}

.auth-frame {
    display: grid;
    grid-template-columns: minmax(280px, 0.95fr) minmax(320px, 1fr);
    width: min(1080px, 100%);
    min-height: 650px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(16, 24, 40, 0.08);
    background: #ffffff;
    box-shadow: 0 30px 70px rgba(16, 24, 40, 0.16);
}

.auth-info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 42px;
    background: #101828;
    color: #ffffff;
}

.auth-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 1.1rem;
    font-weight: 800;
}

.auth-copy h1 {
    margin: 0 0 16px;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0;
}

.auth-copy p {
    margin: 0;
    max-width: 430px;
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.7;
}

.auth-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
}

.auth-metric {
    min-height: 78px;
    padding: 14px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
}

.auth-metric strong {
    display: block;
    font-size: 1.1rem;
}

.auth-metric span {
    display: block;
    margin-top: 4px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.78rem;
}

.auth-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 56px;
}

.auth-card h2 {
    margin: 0;
    font-size: 2.2rem;
    font-weight: 800;
}

.auth-card .auth-subtitle {
    margin: 10px 0 30px;
    color: var(--text-muted);
}

.form-label {
    color: var(--text-main);
    font-weight: 700;
}

.form-control,
.form-select {
    min-height: 44px;
    border-radius: 8px;
    border-color: #cad3df;
}

.form-control:focus,
.form-select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 0.2rem rgba(53, 92, 255, 0.12);
}

.auth-switch {
    margin-top: 22px;
    color: var(--text-muted);
}

.auth-switch a {
    color: var(--primary);
    font-weight: 800;
}

.form-workspace {
    display: grid;
    grid-template-columns: minmax(260px, 360px) minmax(0, 1fr);
    gap: 18px;
    align-items: start;
}

.form-sidebar,
.form-main {
    border: 1px solid var(--surface-line);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: var(--shadow-soft);
}

.form-sidebar {
    padding: 18px;
    background: var(--nav);
    color: #ffffff;
}

.form-sidebar h3,
.form-main h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 800;
}

.form-sidebar p {
    margin: 6px 0 16px;
    color: rgba(255, 255, 255, 0.68);
}

.shape-list {
    display: grid;
    gap: 8px;
}

.shape-option {
    width: 100%;
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    text-align: left;
}

.shape-option:hover,
.shape-option:focus,
.shape-option.is-active {
    border-color: rgba(255, 255, 255, 0.44);
    background: rgba(255, 255, 255, 0.14);
}

.shape-option.is-active {
    box-shadow: inset 4px 0 0 var(--success);
}

.shape-option strong {
    display: block;
    font-size: 0.95rem;
}

.shape-option span {
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.78rem;
}

.shape-visual {
    position: relative;
    display: inline-flex;
    width: 38px;
    min-width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: inset 0 0 0 1px rgba(16, 24, 40, 0.08);
}

.shape-visual::before,
.shape-visual::after {
    content: "";
    position: absolute;
    display: block;
}

.shape-square::before {
    width: 20px;
    height: 20px;
    border: 3px solid var(--primary);
    border-radius: 4px;
    background: rgba(53, 92, 255, 0.08);
}

.shape-cube::before {
    width: 18px;
    height: 18px;
    left: 10px;
    top: 12px;
    border: 3px solid var(--primary);
    border-radius: 4px;
    background: rgba(53, 92, 255, 0.08);
}

.shape-cube::after {
    width: 18px;
    height: 18px;
    left: 15px;
    top: 7px;
    border: 3px solid #14a46f;
    border-radius: 4px;
    background: rgba(20, 164, 111, 0.08);
}

.shape-circle::before,
.shape-sphere::before {
    width: 22px;
    height: 22px;
    border: 3px solid var(--success);
    border-radius: 50%;
    background: rgba(20, 164, 111, 0.08);
}

.shape-sphere::before {
    background: radial-gradient(circle at 30% 28%, #ffffff 0 12%, rgba(20, 164, 111, 0.18) 13% 100%);
}

.shape-rectangle::before {
    width: 26px;
    height: 16px;
    border: 3px solid var(--amber);
    border-radius: 4px;
    background: rgba(246, 166, 9, 0.12);
}

.shape-triangle::before {
    left: 9px;
    top: 8px;
    width: 0;
    height: 0;
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    border-bottom: 22px solid var(--primary);
}

.shape-triangle::after {
    left: 13px;
    top: 15px;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 13px solid #ffffff;
}

.shape-cylinder::before {
    width: 23px;
    height: 22px;
    top: 11px;
    border: 3px solid var(--success);
    border-top-width: 0;
    border-radius: 3px 3px 10px 10px;
    background: rgba(20, 164, 111, 0.08);
}

.shape-cylinder::after {
    width: 23px;
    height: 10px;
    top: 7px;
    border: 3px solid var(--success);
    border-radius: 50%;
    background: #ffffff;
}

.shape-cone::before {
    left: 9px;
    top: 7px;
    width: 0;
    height: 0;
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    border-bottom: 24px solid var(--amber);
}

.shape-cone::after {
    left: 10px;
    bottom: 6px;
    width: 18px;
    height: 7px;
    border: 3px solid var(--amber);
    border-radius: 50%;
    background: #ffffff;
}

.shape-hidden-select {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
}

.form-main {
    padding: 24px;
}

.form-main-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.form-grid .full-span {
    grid-column: 1 / -1;
}

.pending-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 18px 0 22px;
}

.shape-preview {
    margin-top: 18px;
    padding: 16px;
    border: 1px solid #d8e2ee;
    border-radius: 8px;
    background: #fbfcff;
}

.shape-preview span {
    display: block;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
}

.shape-preview strong {
    display: block;
    margin-top: 4px;
    color: var(--text-main);
    font-size: 1.1rem;
}

.shape-preview p {
    margin: 8px 0 4px;
    color: var(--text-main);
}

.shape-preview small {
    color: var(--text-muted);
}

.pending-item {
    min-height: 72px;
    padding: 14px;
    border: 1px dashed #bfccd9;
    border-radius: 8px;
    background: #f8fafc;
}

.pending-item span {
    display: block;
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
}

.pending-item strong {
    display: block;
    margin-top: 6px;
    color: var(--text-main);
}

.form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.danger-eyebrow {
    color: var(--danger);
}

.delete-panel {
    width: min(760px, 100%);
    padding: 24px;
}

.detail-panel {
    width: min(920px, 100%);
    padding: 24px;
}

.detail-hero {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 18px;
    padding: 16px;
    border-radius: 8px;
    background: #f8fafc;
}

.detail-hero .shape-visual {
    width: 58px;
    min-width: 58px;
    height: 58px;
}

.detail-hero h2 {
    margin: 3px 0 8px;
    color: var(--text-main);
    font-size: 1.4rem;
    font-weight: 800;
}

.detail-id {
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
}

.delete-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
    padding: 16px;
    border-radius: 8px;
    background: #fff1f1;
    color: var(--danger);
}

.delete-head strong {
    font-size: 1rem;
}

.delete-head span {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    padding: 0 10px;
    border-radius: 999px;
    background: #ffffff;
    color: var(--text-main);
    font-size: 0.82rem;
    font-weight: 800;
}

.detail-list {
    display: grid;
    grid-template-columns: minmax(130px, 0.35fr) minmax(0, 1fr);
    margin: 0 0 22px;
    border: 1px solid var(--surface-line);
    border-radius: 8px;
    overflow: hidden;
}

.detail-list dt,
.detail-list dd {
    margin: 0;
    padding: 13px 16px;
    border-bottom: 1px solid #eef2f7;
}

.detail-list dt {
    background: #f8fafc;
    color: var(--text-muted);
    font-weight: 800;
}

.detail-list dd {
    background: #ffffff;
    color: var(--text-main);
    font-weight: 600;
}

.detail-list dt:nth-last-of-type(1),
.detail-list dd:nth-last-of-type(1) {
    border-bottom: 0;
}

.validation-summary-errors ul {
    margin-bottom: 0;
}

.validation-summary-valid,
.field-validation-valid {
    display: none;
}

@media (max-width: 992px) {
    .page-head,
    .form-main-head {
        align-items: stretch;
        flex-direction: column;
    }

    .page-actions {
        justify-content: flex-start;
    }

    .grid-panel-head,
    .metric-strip,
    .form-workspace,
    .auth-frame {
        grid-template-columns: 1fr;
    }

    .auth-frame {
        min-height: auto;
    }

    .auth-info {
        gap: 36px;
    }
}

@media (max-width: 640px) {
    .app-body {
        padding-top: 66px;
    }

    .app-shell {
        width: min(100% - 20px, 1500px);
        padding-top: 18px;
    }

    .auth-shell {
        padding: 14px;
    }

    .auth-info,
    .auth-card,
    .form-main {
        padding: 24px;
    }

    .auth-metrics,
    .metric-strip,
    .form-grid,
    .pending-strip {
        grid-template-columns: 1fr;
    }

    .table-toolbar,
    .dashboard-head,
    .toolbar-actions,
    .delete-head {
        align-items: stretch;
        flex-direction: column;
    }

    .grid-detail-grid {
        grid-template-columns: 1fr;
    }

    .filter-group,
    .shape-filter,
    .table-search {
        width: 100%;
    }

    .filter-button {
        flex: 1;
        min-width: 0;
    }

    .detail-list {
        grid-template-columns: 1fr;
    }

    .page-title {
        font-size: 2rem;
    }
}


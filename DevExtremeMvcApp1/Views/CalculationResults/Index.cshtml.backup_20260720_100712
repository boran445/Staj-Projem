@model IEnumerable<DevExtremeMvcApp1.Models.CalculationGridRow>
@using System.Linq

@{
    ViewBag.Title = "Hesaplama Listesi";
    var records = Model.ToList();
}

<div class="page-head">
    <div>
        <span class="eyebrow">&#350;ekil Hesaplama</span>
        <h1 class="page-title">Hesaplama Listesi</h1>
        <p class="page-subtitle">Kay&#305;tlar DevExtreme DataGrid ile listelenir; arama, filtreleme, kolon se&#231;imi, Excel aktar&#305;m&#305; ve sayfalama grid &#252;zerinden yap&#305;l&#305;r.</p>
    </div>

    <div class="page-actions">
        <button type="button" class="btn app-btn app-btn-success" id="calculateAllButton">T&#252;m&#252;n&#252; Hesapla</button>
        <button type="button" class="btn app-btn app-btn-light" id="demoDataButton">Demo Veri</button>
        @Html.ActionLink("Yeni Kayıt", "Create", null, new { @class = "btn app-btn app-btn-primary" })
    </div>
</div>

<div class="grid-action-token">
    @Html.AntiForgeryToken()
</div>

<div id="gridAlertHost">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
</div>

<section class="portal-panel grid-panel">
    <div class="table-toolbar">
        <div>
            <strong>DevExtreme DataGrid</strong>
            <span><span id="recordCountText">@records.Count</span> kay&#305;t listeleniyor</span>
        </div>
    </div>

    <div class="dx-grid-host">
        <div id="calculationGrid"></div>

        <div id="fallbackCalculationTableWrap" class="grid-fallback-table">
            <div class="table-responsive">
                <table class="table app-table align-middle">
                    <thead>
                        <tr>
                            <th>&#350;ekil</th>
                            <th>Id</th>
                            <th>Kullan&#305;c&#305; Id</th>
                            <th>Kullan&#305;c&#305;</th>
                            <th>&#214;l&#231;&#252; 1</th>
                            <th>&#214;l&#231;&#252; 2</th>
                            <th>Alan</th>
                            <th>Hacim</th>
                            <th>Kay&#305;t Tarihi</th>
                            <th>&#304;&#351;lem Tarihi</th>
                            <th>Durum</th>
                            <th class="text-end">&#304;&#351;lemler</th>
                        </tr>
                    </thead>
                    <tbody id="fallbackCalculationTableBody">
                        @if (records.Any())
                        {
                            foreach (var row in records)
                            {
                                <tr>
                                    <td><span class="table-shape">@row.Shape</span></td>
                                    <td>@row.Id</td>
                                    <td>@(row.AppUserId.HasValue ? row.AppUserId.Value.ToString() : "-")</td>
                                    <td>@row.CreatedByUserName</td>
                                    <td>@row.Param1.ToString("0.##")</td>
                                    <td>@(row.Param2.HasValue ? row.Param2.Value.ToString("0.##") : "-")</td>
                                    <td>@(row.Area.HasValue ? row.Area.Value.ToString("0.##") : "-")</td>
                                    <td>@(row.Volume.HasValue ? row.Volume.Value.ToString("0.##") : "-")</td>
                                    <td>@row.CreatedDateText</td>
                                    <td>@row.CalculationDateText</td>
                                    <td>
                                        <span class="@(row.StatusKey == "done" ? "status-badge status-badge-done" : "status-badge status-badge-wait")">@row.Status</span>
                                    </td>
                                    <td class="text-end">
                                        @Html.ActionLink("Detay", "Details", new { id = row.Id }, new { @class = "action-link" })
                                        @Html.ActionLink("Düzenle", "Edit", new { id = row.Id }, new { @class = "action-link" })
                                        @using (Html.BeginForm("CalculateOne", "CalculationResults", new { id = row.Id }, FormMethod.Post, new { @class = "inline-action-form" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-link action-link-success">Hesapla</button>
                                        }
                                        @Html.ActionLink("Sil", "Delete", new { id = row.Id }, new { @class = "action-link action-link-danger" })
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="12" class="empty-table-cell">Hen&#252;z kay&#305;t bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script>
    var localGridRows = @Html.Raw(Json.Encode(records));
    var gridRowsUrl = '@Url.Action("GridRowsJson", "CalculationResults")';
    var detailUrlTemplate = '@Url.Action("Details", "CalculationResults", new { id = "__id__" })';
    var editUrlTemplate = '@Url.Action("Edit", "CalculationResults", new { id = "__id__" })';
    var calculateAllUrl = '@Url.Action("CalculateAllJson", "CalculationResults")';
    var calculateOneUrlTemplate = '@Url.Action("CalculateOneJson", "CalculationResults", new { id = "__id__" })';
    var createDemoDataUrl = '@Url.Action("CreateDemoDataJson", "CalculationResults")';
    var deleteJsonUrlTemplate = '@Url.Action("DeleteJson", "CalculationResults", new { id = "__id__" })';

    function gridUrl(template, id) {
        return template.replace("__id__", encodeURIComponent(id));
    }

    function getAntiForgeryToken() {
        return $('input[name="__RequestVerificationToken"]').first().val();
    }

    function getGrid() {
        try {
            return $("#calculationGrid").dxDataGrid("instance");
        } catch (error) {
            return null;
        }
    }

    function createGridStore(rows) {
        if (!window.DevExpress || !DevExpress.data || !DevExpress.data.ArrayStore) {
            return rows || [];
        }

        return new DevExpress.data.ArrayStore({
            key: "Id",
            data: rows || []
        });
    }

    function getRenderedDataRowCount() {
        return $("#calculationGrid .dx-data-row").length;
    }

    function formatNumber(value) {
        if (value === null || value === undefined || value === "") {
            return "-";
        }

        if (window.DevExpress && DevExpress.localization && typeof DevExpress.localization.formatNumber === "function") {
            return DevExpress.localization.formatNumber(value, {
                type: "fixedPoint",
                precision: 2
            });
        }

        var numberValue = Number(value);
        if (Number.isNaN(numberValue)) {
            return value;
        }

        return numberValue.toLocaleString("tr-TR", {
            maximumFractionDigits: 2
        });
    }

    function fixedNumberText(cellInfo) {
        return formatNumber(cellInfo.value);
    }

    function nullableText(cellInfo) {
        return cellInfo.value === null || cellInfo.value === undefined ? "-" : cellInfo.value;
    }

    function nullableFixedNumberText(cellInfo) {
        return cellInfo.value === null || cellInfo.value === undefined ? "-" : formatNumber(cellInfo.value);
    }

    function normalizeError(xhr, fallbackMessage) {
        if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
            return xhr.responseJSON.message;
        }

        if (xhr && xhr.responseJSON && xhr.responseJSON.Message) {
            return xhr.responseJSON.Message;
        }

        if (xhr && xhr.responseText) {
            return xhr.responseText;
        }

        return fallbackMessage;
    }

    function showGridMessage(message, isSuccess) {
        var alertClass = isSuccess ? "alert-success" : "alert-danger";

        $("#gridAlertHost")
            .empty()
            .append($("<div/>").addClass("alert " + alertClass).text(message));
    }

    function updateFallbackVisibility(grid) {
        var hasRecords = (localGridRows || []).length > 0;
        var renderedRows = getRenderedDataRowCount();

        if (!hasRecords) {
            $("#calculationGrid").show();
            $("#fallbackCalculationTableWrap").show();
            return;
        }

        if (renderedRows === 0) {
            $("#calculationGrid").hide();
            $("#fallbackCalculationTableWrap").show();
            return;
        }

        $("#calculationGrid").show();
        $("#fallbackCalculationTableWrap").hide();
    }

    function reloadGrid() {
        var grid = getGrid();

        if (!grid) {
            window.location.reload();
            return;
        }

        $.ajax({
            url: gridRowsUrl,
            type: "GET",
            dataType: "json",
            cache: false
        }).done(function (rows) {
            rows = rows || [];
            localGridRows = rows;
            renderFallbackTable(rows);
            $("#calculationGrid").show();
            grid.option("dataSource", createGridStore(rows));
            var refreshResult = grid.refresh();
            $("#recordCountText").text(rows.length);

            window.setTimeout(function () {
                updateFallbackVisibility(grid);
            }, 50);

            if (refreshResult && refreshResult.done) {
                refreshResult.done(function () {
                    updateFallbackVisibility(grid);
                });
            }
        }).fail(function (xhr) {
            showGridMessage(normalizeError(xhr, "Kayıt listesi yenilenemedi."), false);
            $("#fallbackCalculationTableWrap").show();
        });
    }

    function postGridAction(url, fallbackMessage) {
        return $.ajax({
            url: url,
            type: "POST",
            data: {
                __RequestVerificationToken: getAntiForgeryToken()
            }
        }).done(function (response) {
            var success = !response || response.success !== false;
            showGridMessage(response && response.message ? response.message : fallbackMessage, success);

            if (success) {
                reloadGrid();
            }
        }).fail(function (xhr) {
            showGridMessage(normalizeError(xhr, fallbackMessage), false);
        });
    }

    function appendActionLink(container, text, url, cssClass) {
        $("<a/>")
            .addClass("action-link " + (cssClass || ""))
            .attr("href", url)
            .text(text)
            .appendTo(container);
    }

    function appendGridActionButton(container, text, cssClass, clickHandler) {
        $("<button/>")
            .attr("type", "button")
            .addClass("action-link " + (cssClass || ""))
            .text(text)
            .on("click", clickHandler)
            .appendTo(container);
    }

    function shapeCellTemplate(container, options) {
        $("<span/>")
            .addClass("table-shape")
            .text(options.value || "-")
            .appendTo(container);
    }

    function resultCellTemplate(container, value) {
        if (value === null || value === undefined) {
            $("<span/>")
                .addClass("muted-badge")
                .append($("<span/>").addClass("status-dot"))
                .append($("<span/>").text("Hesaplanmadı"))
                .appendTo(container);
            return;
        }

        container.text(formatNumber(value));
    }

    function areaCellTemplate(container, options) {
        resultCellTemplate(container, options.value);
    }

    function volumeCellTemplate(container, options) {
        resultCellTemplate(container, options.value);
    }

    function statusCellTemplate(container, options) {
        var data = options.data || {};

        $("<span/>")
            .addClass(data.StatusKey === "done" ? "status-badge status-badge-done" : "status-badge status-badge-wait")
            .text(options.value)
            .appendTo(container);
    }

    function actionsCellTemplate(container, options) {
        var id = options.data.Id;
        var actionWrap = $("<div/>").addClass("dx-grid-actions");

        appendActionLink(actionWrap, "Detay", gridUrl(detailUrlTemplate, id));
        appendActionLink(actionWrap, "Düzenle", gridUrl(editUrlTemplate, id));
        appendGridActionButton(actionWrap, "Hesapla", "action-link-success", function () {
            postGridAction(gridUrl(calculateOneUrlTemplate, id), "Kayıt hesaplandı.");
        });
        appendGridActionButton(actionWrap, "Sil", "action-link-danger", function () {
            if (confirm("Bu kaydı silmek istediğinize emin misiniz?")) {
                postGridAction(gridUrl(deleteJsonUrlTemplate, id), "Kayıt silindi.");
            }
        });

        actionWrap.appendTo(container);
    }

    function addFallbackCell(rowElement, value, cssClass) {
        var cell = $("<td/>");

        if (cssClass) {
            cell.addClass(cssClass);
        }

        if (value && value.jquery) {
            cell.append(value);
        } else {
            cell.text(value === null || value === undefined || value === "" ? "-" : value);
        }

        cell.appendTo(rowElement);
        return cell;
    }

    function renderFallbackTable(rows) {
        var body = $("#fallbackCalculationTableBody").empty();
        rows = rows || [];

        if (!rows.length) {
            $("<tr/>")
                .append($("<td/>").attr("colspan", 12).addClass("empty-table-cell").text("Henüz kayıt bulunmuyor."))
                .appendTo(body);
            return;
        }

        rows.forEach(function (row) {
            var line = $("<tr/>");
            var shape = $("<span/>").addClass("table-shape").text(row.Shape || "-");
            var status = $("<span/>")
                .addClass(row.StatusKey === "done" ? "status-badge status-badge-done" : "status-badge status-badge-wait")
                .text(row.Status || "-");

            addFallbackCell(line, shape);
            addFallbackCell(line, row.Id);
            addFallbackCell(line, row.AppUserId === null || row.AppUserId === undefined ? "-" : row.AppUserId);
            addFallbackCell(line, row.CreatedByUserName || "-");
            addFallbackCell(line, formatNumber(row.Param1));
            addFallbackCell(line, row.Param2 === null || row.Param2 === undefined ? "-" : formatNumber(row.Param2));
            addFallbackCell(line, row.Area === null || row.Area === undefined ? "-" : formatNumber(row.Area));
            addFallbackCell(line, row.Volume === null || row.Volume === undefined ? "-" : formatNumber(row.Volume));
            addFallbackCell(line, row.CreatedDateText || "-");
            addFallbackCell(line, row.CalculationDateText || "-");
            addFallbackCell(line, status);

            var actionCell = $("<td/>").addClass("text-end").appendTo(line);
            var actionWrap = $("<div/>").addClass("dx-grid-actions");

            appendActionLink(actionWrap, "Detay", gridUrl(detailUrlTemplate, row.Id));
            appendActionLink(actionWrap, "Düzenle", gridUrl(editUrlTemplate, row.Id));
            appendGridActionButton(actionWrap, "Hesapla", "action-link-success", function () {
                postGridAction(gridUrl(calculateOneUrlTemplate, row.Id), "Kayıt hesaplandı.");
            });
            appendGridActionButton(actionWrap, "Sil", "action-link-danger", function () {
                if (confirm("Bu kaydı silmek istediğinize emin misiniz?")) {
                    postGridAction(gridUrl(deleteJsonUrlTemplate, row.Id), "Kayıt silindi.");
                }
            });

            actionCell.append(actionWrap);
            line.appendTo(body);
        });
    }

    function onGridToolbarPreparing(e) {
        e.toolbarOptions.items.unshift(
            {
                location: "after",
                widget: "dxButton",
                options: {
                    text: "Kolonlar",
                    icon: "columnchooser",
                    onClick: function () {
                        e.component.showColumnChooser();
                    }
                }
            },
            {
                location: "after",
                widget: "dxButton",
                options: {
                    text: "Yenile",
                    icon: "refresh",
                    onClick: reloadGrid
                }
            }
        );
    }

    function onGridExporting(e) {
        if (!window.ExcelJS || !DevExpress.excelExporter || !window.saveAs) {
            showGridMessage("Excel aktarımı için gerekli DevExtreme dosyaları yüklenemedi.", false);
            e.cancel = true;
            return;
        }

        var workbook = new ExcelJS.Workbook();
        var worksheet = workbook.addWorksheet("Hesaplama Listesi");

        DevExpress.excelExporter.exportDataGrid({
            component: e.component,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: "application/octet-stream" }), "Hesaplama_Listesi.xlsx");
            });
        });

        e.cancel = true;
    }

    function onGridContentReady(e) {
        $("#recordCountText").text((localGridRows || []).length);

        window.setTimeout(function () {
            updateFallbackVisibility(e.component);
        }, 0);
    }

    function createCalculationGrid() {
        if (!window.DevExpress || !$.fn.dxDataGrid) {
            $("#fallbackCalculationTableWrap").show();
            return;
        }

        DevExpress.localization.locale("tr");

        $("#calculationGrid").dxDataGrid({
            dataSource: createGridStore(localGridRows || []),
            keyExpr: "Id",
            paging: {
                pageSize: 10
            },
            pager: {
                visible: true,
                showPageSizeSelector: true,
                allowedPageSizes: [10, 25, 50, 100],
                showInfo: true
            },
            searchPanel: {
                visible: true,
                highlightCaseSensitive: true,
                placeholder: "Grid içinde ara"
            },
            groupPanel: {
                visible: false
            },
            grouping: {
                autoExpandAll: false
            },
            allowColumnReordering: true,
            allowColumnResizing: true,
            rowAlternationEnabled: true,
            showBorders: true,
            width: "100%",
            height: "auto",
            columnAutoWidth: true,
            remoteOperations: false,
            repaintChangesOnly: false,
            noDataText: "Henüz kayıt bulunmuyor.",
            scrolling: {
                mode: "standard",
                useNative: true
            },
            loadPanel: {
                enabled: false
            },
            filterRow: {
                visible: false,
                applyFilter: "auto"
            },
            headerFilter: {
                visible: true
            },
            columnChooser: {
                enabled: true,
                mode: "select",
                title: "Kolon Seçici",
                emptyPanelText: "Göstermek istediğiniz kolonları seçin"
            },
            stateStoring: {
                enabled: false
            },
            export: {
                enabled: true,
                allowExportSelectedData: true
            },
            sorting: {
                mode: "multiple"
            },
            columns: [
                { dataField: "Shape", caption: "Şekil", cellTemplate: shapeCellTemplate },
                { dataField: "Id", caption: "Id", dataType: "number", width: 80, alignment: "center" },
                { dataField: "AppUserId", caption: "Kullanıcı Id", dataType: "number", width: 120, alignment: "center", customizeText: nullableText },
                { dataField: "CreatedByUserName", caption: "Kullanıcı" },
                { dataField: "Param1", caption: "Ölçü 1", dataType: "number", alignment: "right", customizeText: fixedNumberText },
                { dataField: "Param2", caption: "Ölçü 2", dataType: "number", alignment: "right", customizeText: nullableFixedNumberText },
                { dataField: "Area", caption: "Alan", dataType: "number", alignment: "right", allowGrouping: false, cellTemplate: areaCellTemplate },
                { dataField: "Volume", caption: "Hacim", dataType: "number", alignment: "right", allowGrouping: false, cellTemplate: volumeCellTemplate },
                { dataField: "CreatedDateText", caption: "Kayıt Tarihi", dataType: "string" },
                { dataField: "CalculationDateText", caption: "İşlem Tarihi", dataType: "string", sortOrder: "desc" },
                { dataField: "Status", caption: "Durum", cellTemplate: statusCellTemplate },
                {
                    caption: "İşlemler",
                    width: 330,
                    alignment: "right",
                    allowFiltering: false,
                    allowSorting: false,
                    allowGrouping: false,
                    cellTemplate: actionsCellTemplate
                }
            ],
            onToolbarPreparing: onGridToolbarPreparing,
            onExporting: onGridExporting,
            onContentReady: onGridContentReady
        });
    }

    $(function () {
        renderFallbackTable(localGridRows || []);
        createCalculationGrid();
        $("#recordCountText").text((localGridRows || []).length);

        $("#calculateAllButton").on("click", function () {
            postGridAction(calculateAllUrl, "Kayıtlar hesaplandı.");
        });

        $("#demoDataButton").on("click", function () {
            postGridAction(createDemoDataUrl, "Demo kayıtlar eklendi.");
        });
    });
</script>

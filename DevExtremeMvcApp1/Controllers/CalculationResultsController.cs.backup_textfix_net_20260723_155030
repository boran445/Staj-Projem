                ModelState.AddModelError("Param1", "Ã–lÃ§Ã¼ 1 deÄŸeri 0'dan bÃ¼yÃ¼k olmalÄ±dÄ±r.");
            }

            if (RequiresSecondMeasure(shapeType) && (!param2.HasValue || param2.Value <= 0))
            {
                ModelState.AddModelError("Param2", "Bu ÅŸekil iÃ§in Ã–lÃ§Ã¼ 2 deÄŸeri 0'dan bÃ¼yÃ¼k olmalÄ±dÄ±r.");

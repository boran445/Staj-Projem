        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<ActionResult> CalculateSelectedJson(int[] ids)
        {
            if (ids == null || !ids.Any())
            {
                return Json(new
                {
                    success = false,
                    message = "Önce hesaplanacak kayıtları seçmelisiniz."
                });
            }

            var selectedIds = ids
                .Where(x => x > 0)
                .Distinct()
                .ToList();

            if (!selectedIds.Any())
            {
                return Json(new
                {
                    success = false,
                    message = "Seçilen kayıt bilgisi geçersiz."
                });
            }

            int calculatedCount = 0;
            var errorMessages = new List<string>();

            foreach (int selectedId in selectedIds)
            {
                OperationResult result = await CalculateOneInternal(selectedId);
                if (result.Success)
                {
                    calculatedCount++;
                }
                else
                {
                    errorMessages.Add("Id " + selectedId + ": " + result.Message);
                }
            }

            if (errorMessages.Any())
            {
                return Json(new
                {
                    success = false,
                    message = calculatedCount + " kayıt hesaplandı. Hata: " + string.Join(" | ", errorMessages)
                });
            }

            return Json(new
            {
                success = true,
                message = calculatedCount + " seçili kayıt hesaplandı ve veritabanı güncellendi."
            });
        }

        private async Task<OperationResult> CalculateOneInternal(int id)
        {
            Uri inputApiUri = new Uri(Request.Url, Url.Content("~/api/input/calculate-record/" + id));

            using (var client = new HttpClient())
            {
                HttpResponseMessage response = await client.PostAsJsonAsync(inputApiUri, new BatchCalculationRequest
                {
                    AppUserId = null,
                    UserName = null
                });

                if (response.IsSuccessStatusCode)
                {
                    CalculationResponse result = await response.Content.ReadAsAsync<CalculationResponse>();
                    return OperationResult.Ok("Id " + result.Id + " kaydı hesaplandı ve veritabanı güncellendi.");
                }

                string responseBody = await response.Content.ReadAsStringAsync();
                return OperationResult.Fail(string.IsNullOrWhiteSpace(responseBody)
                    ? "Kayıt hesaplanamadı."
                    : responseBody);
            }
        }

